# =============================================================================
# SECRET TEMPLATE — DO NOT COMMIT REAL VALUES
# =============================================================================
# Copy this file to `secret.yaml` and replace each `CHANGE_ME_*` with a real
# value, then apply with:
#
#   cp k8s/secret.yaml.example k8s/secret.yaml
#   # edit k8s/secret.yaml  (and keep it OUT of git — see .gitignore)
#   kubectl apply -f k8s/secret.yaml
#
# Or, better, generate the secret on the server so the plaintext never touches
# disk or git:
#
#   kubectl create secret generic velomanage-secrets -n velomanage \
#     --from-literal=MONGODB_URI='mongodb+srv://...' \
#     --from-literal=JWT_SECRET="$(openssl rand -hex 32)" \
#     --from-literal=ADMIN_PASSWORD='...' \
#     --from-literal=STRIPE_SECRET_KEY='sk_live_...' \
#     --from-literal=REDIS_URL='redis://...' \
#     --from-literal=FRONTEND_URL='https://velomanage.example.com' \
#     --from-literal=SOCKET_CORS_ORIGIN='https://velomanage.example.com'
#
# Make sure `k8s/secret.yaml` is in `.gitignore`!
# =============================================================================
apiVersion: v1
kind: Secret
metadata:
  name: velomanage-secrets
  namespace: velomanage
  labels:
    app.kubernetes.io/name: velomanage
    app.kubernetes.io/part-of: velomanage
type: Opaque
stringData:
  # Full MongoDB Atlas connection string (or in-cluster mongo).
  # Use the SRV form for Atlas: mongodb+srv://<user>:<pass>@<cluster>/velomanage?retryWrites=true&w=majority
  MONGODB_URI: "CHANGE_ME_MONGODB_URI"

  # JWT signing secret. Generate with: openssl rand -hex 32
  JWT_SECRET: "CHANGE_ME_JWT_SECRET_64_HEX_CHARS"

  # Initial admin password (used by scripts/init-database.js on first boot).
  ADMIN_PASSWORD: "CHANGE_ME_ADMIN_PASSWORD"

  # Stripe secret key (server-side). Use sk_live_... for production.
  STRIPE_SECRET_KEY: "CHANGE_ME_STRIPE_SECRET_KEY"

  # Redis connection URL (for future sessions / queue / cache).
  REDIS_URL: "CHANGE_ME_REDIS_URL"

  # Public front-end URL — used for CORS and email links.
  FRONTEND_URL: "https://velomanage.example.com"

  # CORS origin for the socket.io server.
  SOCKET_CORS_ORIGIN: "https://velomanage.example.com"
