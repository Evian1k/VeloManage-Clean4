# VeloManage Frontend — Environment Variables Template
# Copy to frontend/.env (local) or set in Vercel → Settings → Environment Variables.

# REST API base URL — must include /api/v1
VITE_API_URL=https://your-backend.onrender.com/api/v1

# Socket.io host — bare host, NO /api/v1 path
# If omitted, it will be derived from VITE_API_URL by stripping /api/...
VITE_SOCKET_URL=https://your-backend.onrender.com

# Public-facing URL of this frontend (used for reference / metadata)
VITE_FRONTEND_URL=https://your-frontend.vercel.app

# Optional integrations
VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
