# VeloManage — Frontend Production Environment Variables (root-level convenience)
# Copy to .env (local) or set in Vercel → Settings → Environment Variables.

# REST API base URL — must include /api/v1
VITE_API_URL=https://your-backend.onrender.com/api/v1
VITE_API_BASE_URL=https://your-backend.onrender.com/api/v1

# Socket.io host — bare host, NO /api/v1 path
VITE_SOCKET_URL=https://your-backend.onrender.com

# Public-facing URL of this frontend
VITE_FRONTEND_URL=https://your-frontend.vercel.app

# App metadata
VITE_APP_NAME=VeloManage
VITE_APP_VERSION=1.0.0
VITE_API_TIMEOUT=10000

# Optional third-party integrations (leave blank if not used)
VITE_GOOGLE_MAPS_API_KEY=
VITE_STRIPE_PUBLISHABLE_KEY=
