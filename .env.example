# AutoCare Pro Frontend - Production Environment Variables

# Application Info
VITE_APP_NAME=AutoCare Pro
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Premium Car Management System

# API Configuration
VITE_API_BASE_URL=https://velomanage-clean4-2.onrender.com/api/v1
VITE_API_TIMEOUT=10000

# Authentication
VITE_JWT_SECRET=your-jwt-secret-key
VITE_JWT_EXPIRES_IN=24h

# External Services
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
VITE_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
VITE_EMAILJS_SERVICE_ID=your-emailjs-service-id
VITE_EMAILJS_TEMPLATE_ID=your-emailjs-template-id
VITE_EMAILJS_USER_ID=your-emailjs-user-id

# File Upload / Storage
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# Backend CORS / Frontend URL
VITE_FRONTEND_URL=https://velo-manage-clean4.vercel.app
