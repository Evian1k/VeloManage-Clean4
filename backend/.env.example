# VeloManage Backend — Environment Variables Template
# Copy to backend/.env (local) or set these in Render → Environment tab.
# NEVER commit real secrets to git.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=10000
NODE_ENV=production
API_VERSION=v1

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<url-encoded-password>@<cluster-host>/<dbname>?retryWrites=true&w=majority&appName=<ClusterName>
# IMPORTANT: URL-encode the password if it contains special characters
#   @ → %40   : → %3A   / → %2F   ? → %3F   # → %23
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST.mongodb.net/velomanage?retryWrites=true&w=majority&appName=Cluster0

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate a strong 64+ char secret, e.g. `openssl rand -hex 32`
JWT_SECRET=CHANGE_ME_to_a_long_random_string
JWT_EXPIRES_IN=24h

# Shared password for admin email registration / login (see User model ADMIN_EMAILS list)
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# ---------------------------------------------------------------------------
# CORS / Frontend
# ---------------------------------------------------------------------------
FRONTEND_URL=https://your-frontend.vercel.app
# Optional: comma-separated extra origins
ADDITIONAL_CORS_ORIGINS=

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000      # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# ---------------------------------------------------------------------------
# File Upload
# ---------------------------------------------------------------------------
MAX_FILE_SIZE=10485760           # 10 MB
UPLOAD_DIR=uploads

# ---------------------------------------------------------------------------
# WebSocket
# ---------------------------------------------------------------------------
SOCKET_CORS_ORIGIN=https://your-frontend.vercel.app

# ---------------------------------------------------------------------------
# Email (optional, for future features)
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------------------------------------------------------------------------
# GPS Defaults (Nairobi)
# ---------------------------------------------------------------------------
DEFAULT_LAT=-1.2921
DEFAULT_LNG=36.8219
GPS_UPDATE_INTERVAL=30000

# ---------------------------------------------------------------------------
# Stripe (optional, for payments)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
